<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <plone:service
      method="GET"
      factory=".get.SearchBlocksGet"
      for="zope.interface.Interface"
      permission="collective.searchblocks.SearchBlocks"
      layer="collective.searchblocks.interfaces.IBrowserLayer"
      name="@search-blocks"
      />

</configure>
